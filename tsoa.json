{
  "entryFile": "src/api/server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/api/controllers/*Controller.ts"],
  "spec": {
    "outputDirectory": "docs/generated",
    "specVersion": 3,
    "basePath": "/api",
    "name": "AAPI",
    "description": "A model-agnostic, contract-first gateway for governed agentic capabilities.",
    "version": "0.1.0",
    "schemes": ["http"]
  },
  "routes": {
    "routesDir": ".generated",
    "basePath": "/api",
    "middleware": "express",
    "esm": true
  }
}
